RewriteEngine On

# ── Force HTTPS (A02 – Cryptographic Failures) ───────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Prevent directory listing (A05 – Security Misconfiguration) ──────────────
Options -Indexes

# ── Protect sensitive files (A05) ─────────────────────────────────────────────
<FilesMatch "\.(sql|md|log|json|lock|env|bak|sh|pem|key|crt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow manifest.json explicitly
<Files "manifest.json">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Allow from all
    </IfModule>
</Files>

# ── Protect server-side directories (A01 – Broken Access Control) ────────────
<IfModule mod_rewrite.c>
    RewriteRule ^config/   - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^dep/      - [F,L]
    RewriteRule ^node_modules/ - [F,L]
    RewriteRule ^src/      - [F,L]
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|phar)$ - [F,L]
</IfModule>

# ── PHP Hardening (handled cleanly in config/security.php via ini_set) ────────
# php_value / php_flag inside .htaccess cause HTTP 500 Internal Server Error on PHP-FPM/FastCGI servers

# ── Security Headers (A05 – Security Misconfiguration) ────────────────────────
<IfModule mod_headers.c>
    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable browser features not needed (allowing geolocation for attendance)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"

    # HSTS – enforce HTTPS for 1 year (A02)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content Security Policy (A03 / A08)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://unpkg.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https: https://www.google-analytics.com; connect-src 'self' https://unpkg.com https://api.iconify.design https://www.google-analytics.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"

    # Remove server signature
    Header always unset Server
    Header always unset X-Powered-By

    # Prevent caching of sensitive pages
    <FilesMatch "\.(php)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ── Browser Caching for Static Assets (SEO Speed) ────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg          "access plus 1 year"
    ExpiresByType image/png           "access plus 1 year"
    ExpiresByType image/webp          "access plus 1 year"
    ExpiresByType image/svg+xml       "access plus 1 year"
    ExpiresByType image/gif           "access plus 1 year"
    ExpiresByType image/x-icon        "access plus 1 year"
    ExpiresByType text/css            "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType font/woff2          "access plus 1 year"
    ExpiresByType font/woff           "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/ttf            "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
</IfModule>

# ── GZIP Compression (SEO Speed) ─────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE application/xml text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Error Pages ───────────────────────────────────────────────────────────────
# ErrorDocument 404 /index.php
# ErrorDocument 403 /index.php
# ErrorDocument 500 /index.php
